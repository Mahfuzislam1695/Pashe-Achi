# The project's one environment file. Copy .env.example to .env and fill it in; the server refuses
# to start if anything is missing or invalid. NODE_ENV is set for you: development for
# `npm run dev`, production for `npm start`.

# The one port for everything: the customer site (/), the admin panel (/admin) and the API (/api/v1).
PORT=3000

# PostgreSQL with a UTF8 database (or `docker compose up -d`, which uses pashe/pashe).
DATABASE_URL=postgresql://pashe:pashe@localhost:5432/pashe_achi?schema=public

# Long random strings (32+ characters), different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-customer-access-secret-at-least-32-chars
ADMIN_JWT_ACCESS_SECRET=change-me-admin-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded prescriptions are stored (relative to the project folder).
UPLOAD_DIR=uploads

# First super admin, created by `npm run db:seed` if no admin with this mobile exists.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_MOBILE=01700000000
SEED_ADMIN_PASSWORD=change-me-now

LOG_LEVEL=info
