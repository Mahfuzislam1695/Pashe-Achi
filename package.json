{
  "name": "pashe-achi",
  "version": "0.1.0",
  "private": true,
  "description": "Pashe Achi: one project and one server on one port. NestJS API, customer site and admin panel (Next.js), Prisma and PostgreSQL.",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "prisma generate && nest start --watch -- --dev",
    "build": "prisma generate && next build && nest build",
    "start": "node dist/server/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --dir src/shared && jest",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "prisma db seed -- --demo",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.104.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "helmet": "8.3.0",
    "lucide-react": "1.54.0",
    "multer": "2.4.0",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "shadcn": "4.21.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
