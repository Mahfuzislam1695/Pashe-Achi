// Pashe Achi database. After editing: `npm run db:migrate` (creates a migration), then `npm run db:generate`.
// Amounts are whole taka (Int). Every order keeps a snapshot of the fees it was priced with.

generator client {
  provider            = "prisma-client"
  output              = "../src/server/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  bn
  en
}

enum ServiceId {
  bazar
  shifting
  medicine
  parcel
}

/// Bazar and medicine: PENDING (no prices) → QUOTED (staff priced every line) → BOOKED once the
/// customer confirms. Shifting and parcel are priced from the Catalog and go PENDING → BOOKED.
enum OrderStatus {
  PENDING
  QUOTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Who acted: used by both the order timeline (OrderStatusEvent) and the history log (AuditLog).
enum OrderEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS
  ORDER_BILL
  ANNOUNCEMENT
  OFFER
}

enum AuditAction {
  CUSTOMER_SIGNED_UP
  CUSTOMER_PROFILE_UPDATED
  CUSTOMER_PASSWORD_CHANGED
  CUSTOMER_BLOCKED
  CUSTOMER_UNBLOCKED
  CUSTOMER_POINTS_CHANGED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_BILL_UPDATED
  PRICING_UPDATED
  VEHICLE_CREATED
  VEHICLE_UPDATED
  SUPPORT_UPDATED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_PASSWORD_RESET
  ADMIN_SIGNED_IN
  ADMIN_SIGN_IN_FAILED
  ADMIN_SIGNED_OUT
  ADMIN_PASSWORD_CHANGED
  ANNOUNCEMENT_SENT
  DELIVERY_HOURS_UPDATED
  CUSTOMER_LOCATION_ADDED
  CUSTOMER_LOCATION_UPDATED
  CUSTOMER_LOCATION_DELETED
  OFFER_CREATED
  OFFER_UPDATED
  OFFER_DELETED
  OFFER_ANNOUNCED
  CUSTOMER_AUTH_UPDATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  CUSTOMER_DELETED
  SYSTEM_BACKUP_DOWNLOADED
  APK_UPLOADED
  APK_REMOVED
}

enum AuditEntity {
  ORDER
  CUSTOMER
  STAFF
  PRICING
  VEHICLE
  SUPPORT
  ANNOUNCEMENT
  DELIVERY_HOURS
  OFFER
  CUSTOMER_AUTH
  ROLE
  SYSTEM
}

/// A customer of the web/mobile app.
model User {
  id                String             @id @default(cuid())
  name              String
  mobile            String             @unique
  /// The customer's one location, always picked on the map: the address the map gave for the pin,
  /// the house/flat/road they added, and the pin (null only for accounts from before pins).
  location          String             @default("")
  locationDetails   String             @default("")
  locationLat       Float?
  locationLng       Float?
  passwordHash      String
  points            Int                @default(0)
  lang              Lang               @default(bn)
  isBlocked         Boolean            @default(false)
  /// Set when the customer deleted their account. The row stays, emptied of personal details, so
  /// past bills still add up; the mobile becomes "deleted-<id>", freeing the number for a new signup.
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  uploads           Upload[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]

  @@index([createdAt])
}

/// Staff who use the admin panel. Kept apart from customers so the two sessions never mix.
model Admin {
  id                String             @id @default(cuid())
  name              String
  mobile            String             @unique
  passwordHash      String
  roleId            String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  orderEvents       OrderStatusEvent[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
}

/// What a staff member may do: a list of module.action permissions (see src/shared/permissions.ts),
/// made and edited by the Super admin on /admin/roles. Each admin has one role.
model Role {
  id            String   @id @default(cuid())
  /// Built-in roles: super_admin (the system role), manager, operator. Null for roles made in the panel.
  key           String?  @unique
  nameBn        String
  nameEn        String   @unique
  descriptionBn String?
  descriptionEn String?
  /// The system role (Super admin) has every permission whatever `permissions` holds, and is never edited.
  isSystem      Boolean  @default(false)
  permissions   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admins        Admin[]
}

/// One row per issued refresh token (hashed). Rotated on every refresh; a reused token revokes its family.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familyId   String
  userId     String?
  adminId    String?
  userAgent  String?
  /// Null for customers: their sessions never expire. Admin tokens expire after REFRESH_TOKEN_TTL_DAYS.
  expiresAt  DateTime?
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([adminId])
}

model Order {
  id            String             @id @default(cuid())
  /// Shown as PA-<number>. The sequence starts at 1001 (see the first migration).
  number        Int                @unique @default(autoincrement())
  userId        String
  service       ServiceId
  status        OrderStatus        @default(PENDING)
  /// One line for lists and notifications.
  summary       String
  contactMobile String
  address       String?
  /// The map pin for `address` (bazar, medicine), if the customer set one.
  addressLat    Float?
  addressLng    Float?
  note          String?
  scheduledDate DateTime           @db.Date
  /// HH:mm, Bangladesh time.
  scheduledTime String
  itemsTotal    Int
  serviceFee    Int
  deliveryFee   Int
  total         Int
  /// Bazar, medicine and shifting: how many quotes staff have sent. A confirm must name the latest one.
  quoteVersion  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  shifting      ShiftingDetail?
  parcel        ParcelDetail?
  uploads       Upload[]
  events        OrderStatusEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([service, createdAt])
  @@index([createdAt])
}

/// A bazar or medicine line.
model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  position Int
  name     String
  quantity String
  variety  String?
  company  String?
  category String?
  price    Int?
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, position])
}

model ShiftingDetail {
  orderId               String   @id
  loadingArea           String
  unloadingArea         String
  loadingLat            Float?
  loadingLng            Float?
  unloadingLat          Float?
  unloadingLng          Float?
  vehicleId             String?
  vehicleNameBn         String
  vehicleNameEn         String
  /// The vehicle rent staff set by distance in a quote; null until they send it.
  vehicleRate           Int?
  labourers             Int
  wagePerLabourer       Int
  loadingFloor          Int
  loadingRatePerFloor   Int
  unloadingFloor        Int
  unloadingRatePerFloor Int
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle               Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
}

model ParcelDetail {
  orderId        String  @id
  product        String
  weight         String?
  pickupAddress  String
  dropoffAddress String
  pickupLat      Float?
  pickupLng      Float?
  dropoffLat     Float?
  dropoffLng     Float?
  receiverMobile String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// A file a customer uploaded (prescriptions). Attached to an order when the order is placed.
model Upload {
  id           String   @id @default(cuid())
  ownerId      String
  orderId      String?
  originalName String
  mime         String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([orderId])
}

model OrderStatusEvent {
  id        String          @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  note      String?
  actor     OrderEventActor
  adminId   String?
  createdAt DateTime        @default(now())
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin     Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/// The history log: who did what, to which record, and when. Written in the same transaction as the
/// change it records, and never edited. Names and labels are snapshots, so a row still reads correctly
/// after a rename. Passwords and hashes are never stored.
model AuditLog {
  id          String          @id @default(cuid())
  action      AuditAction
  actorType   OrderEventActor
  adminId     String?
  userId      String?
  /// The actor's name at the time (for a failed sign-in with an unknown mobile: the mobile typed).
  actorName   String
  /// The admin's role name at the time, { bn, en }.
  actorRole   Json?
  entityType  AuditEntity
  entityId    String?
  /// "PA-1042", or the customer, staff member or vehicle name at the time.
  entityLabel String?
  /// [{ field, label?, from, to }]: only the fields that changed.
  changes     Json            @default("[]")
  note        String?
  /// Extra facts for some actions, e.g. { service, total } or { sent } or { reason }.
  meta        Json            @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  admin       Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Fees and rates. A single row with id 1, edited in the admin panel's Catalog page.
model Pricing {
  id                    Int      @id @default(1)
  bazarShoppingFee      Int
  bazarDeliveryFee      Int
  medicineDeliveryFee   Int
  parcelDeliveryFee     Int
  wagePerLabourer       Int
  loadingRatePerFloor   Int
  unloadingRatePerFloor Int
  updatedAt             DateTime @updatedAt
}

model Vehicle {
  id        String           @id @default(cuid())
  slug      String           @unique
  nameBn    String
  nameEn    String
  rate      Int
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  shiftings ShiftingDetail[]
}

/// Simple key/value settings (support phone and WhatsApp link, delivery hours per service).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// আজকের অফার: a promotion staff post with an optional picture. Customers (and the public landing
/// page) see it from startsOn to endsOn, Bangladesh days, while isActive. English falls back to Bangla.
model Offer {
  id             String     @id @default(cuid())
  titleBn        String
  titleEn        String?
  bodyBn         String?
  bodyEn         String?
  /// The service its "অর্ডার করুন" button opens, if any.
  service        ServiceId?
  startsOn       DateTime   @db.Date
  endsOn         DateTime   @db.Date
  isActive       Boolean    @default(true)
  /// The picture, through StorageService (offers/…). imageUpdatedAt versions its public URL.
  imageKey       String?
  imageMime      String?
  imageSize      Int?
  imageUpdatedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive, startsOn, endsOn])
}

/// An in-app notification for exactly one customer (userId) or one admin (adminId).
model Notification {
  id        String           @id @default(cuid())
  userId    String?
  adminId   String?
  type      NotificationType
  titleBn   String
  titleEn   String
  bodyBn    String
  bodyEn    String
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin     Admin?           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([userId, readAt])
  @@index([adminId, readAt])
}

enum PushAudience {
  CUSTOMER
  ADMIN
}

/// A browser that gets phone or desktop push notifications (Web Push). One browser has at most one
/// customer and one admin owner: signing in as someone else on a shared phone moves it to them.
model PushSubscription {
  id        String       @id @default(cuid())
  endpoint  String
  p256dh    String
  auth      String
  audience  PushAudience
  userId    String?
  adminId   String?
  /// Where a tap opens: "" (customer site) or "/admin".
  basePath  String       @default("")
  lang      Lang         @default(bn)
  userAgent String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin     Admin?       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([endpoint, audience])
  @@index([userId])
  @@index([adminId])
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// A phone running the Kingfisher app (Flutter, mobile/) that gets push notifications through Firebase
/// Cloud Messaging. A token has one customer: signing in as someone else on the phone moves it to them.
model DeviceToken {
  id         String         @id @default(cuid())
  token      String         @unique
  platform   DevicePlatform
  userId     String
  /// The language the app was in when it registered (or last changed language).
  lang       Lang           @default(bn)
  appVersion String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
